{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "lib": ["dom", "esnext"],
    "types": ["node"],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts"]
}

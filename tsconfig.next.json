{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-cloud/types/**/*.ts",
    ".next-cloud/dev/types/**/*.ts",
    ".next-local-review/types/**/*.ts",
    ".next-local-review/dev/types/**/*.ts",
    ".next-fran-loop/types/**/*.ts",
    ".next-fran-loop/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

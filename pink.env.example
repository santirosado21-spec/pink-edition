# Copiar a .env.local (web) y exportar en el procesador. Nunca subir a Git.

# --- Web, modo nube. Si faltan estas dos, la web funciona en modo local sin cuentas. ---
NEXT_PUBLIC_SUPABASE_URL=https://awptxbhlraiddimobwzv.supabase.co
# Clave publicable (pensada para el navegador). Se ve en Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Propuesta automática de edición (servidor de la web) ---
ANTHROPIC_API_KEY=

# --- Procesador (scripts/worker.py), sólo en el equipo que edita ---
SUPABASE_URL=https://awptxbhlraiddimobwzv.supabase.co
# Clave de servicio: da acceso total a la base. Nunca en el navegador, en Vercel ni en Git.
SUPABASE_SERVICE_ROLE_KEY=
